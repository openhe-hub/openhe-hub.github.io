---
import { SITE, BASE } from '../lib/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap-wide bar label">
    <span>© {year} {SITE.author}</span>
    <span class="links">
      <a href={`${BASE}/rss.xml`}>rss</a>
      {SITE.github && <a href={SITE.github}>github</a>}
      {SITE.email && <a href={`mailto:${SITE.email}`}>email</a>}
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .links {
    display: inline-flex;
    gap: 1.2rem;
  }

  a {
    color: var(--ink-2);
    transition: color 120ms ease;
  }

  a:hover {
    color: var(--accent);
  }
</style>
