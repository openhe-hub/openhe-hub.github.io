---
interface Props {
  date: Date;
  format?: 'long' | 'month';
}

const { date, format = 'long' } = Astro.props;
const text = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  ...(format === 'long' ? { day: 'numeric' } : {}),
});
---

<time datetime={date.toISOString().slice(0, 10)}>{text}</time>
